---
import '../styles/global.css';
import { brands } from '../data/brands.js';

const {
  brand = 'cafe',
  active = 'home',
  title = '',
  description = ''
} = Astro.props;
const site = brands[brand];
const pageTitle = title ? `${title} — ${site.fullName}` : site.fullName;
---
<!doctype html>
<html lang="id" style={`--accent:${site.accent};--accent-dark:${site.accentDark};--accent-soft:${site.accentSoft};--ink:${site.ink};--canvas:${site.canvas};--paper:${site.paper};`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || `${site.fullName} — crafted food & drink experience.`} />
    <meta name="theme-color" content={site.canvas} />
    <link rel="icon" type="image/svg+xml" href={site.logo} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brandmark" href={site.home}>
          <img src={site.logo} alt={`Logo ${site.fullName}`} />
          <span class="brandmark__text">
            <strong>{site.name}</strong>
            <span>{site.kicker}</span>
          </span>
        </a>
        <nav class="main-nav" aria-label="Navigasi utama">
          <a href={site.home} aria-current={active === 'home' ? 'page' : undefined}>Beranda</a>
          <a href={site.product} aria-current={active === 'product' ? 'page' : undefined}>Produk</a>
          <a href={site.contact} aria-current={active === 'contact' ? 'page' : undefined}>Kontak</a>
          <a class="nav-cta" href={site.contact}>Reservasi / Order</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__top">
        <div class="footer-logo">
          <img src={site.logo} alt="" aria-hidden="true" />
          <div>
            <strong>{site.fullName}</strong>
            <span>Small-batch craft · made to be shared</span>
          </div>
        </div>
        <nav class="footer-nav" aria-label="Navigasi footer">
          <a href={site.home}>Beranda</a>
          <a href={site.product}>Produk</a>
          <a href={site.contact}>Kontak</a>
          <a href="/">Portal</a>
        </nav>
      </div>
      <div class="shell site-footer__bottom">
        <span>© 2026 {site.fullName}. Academic demo project.</span>
        <span>Built with Astro · No heavy animation framework.</span>
      </div>
    </footer>
  </body>
</html>
