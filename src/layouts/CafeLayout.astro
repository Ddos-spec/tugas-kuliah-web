---
import '../styles/cafe.css';
import { brands } from '../data/brands.js';

const { active = 'home', title = '', description = '' } = Astro.props;
const site = brands.cafe;
const pageTitle = title ? `${title} — ${site.fullName}` : site.fullName;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || `${site.fullName} — specialty coffee and pastry.`} />
    <meta name="theme-color" content="#f3ede1" />
    <link rel="icon" type="image/svg+xml" href={site.logo} />
    <title>{pageTitle}</title>
  </head>
  <body class="c-site">
    <header class="c-header">
      <a class="c-brand" href={site.home} aria-label="Amber & Bean beranda">
        <img src={site.logo} alt="Logo Amber & Bean Coffee Roasters" />
        <span><strong>Amber &amp; Bean</strong><small>Coffee Roasters</small></span>
      </a>
      <nav class="c-nav" aria-label="Navigasi Amber & Bean">
        <a href={site.home} aria-current={active === 'home' ? 'page' : undefined}>Beranda</a>
        <a href={site.product} aria-current={active === 'product' ? 'page' : undefined}>Produk</a>
        <a href={site.contact} aria-current={active === 'contact' ? 'page' : undefined}>Kontak</a>
      </nav>
      <a class="c-header-cta" href={site.contact}>Reserve a table</a>
    </header>
    <main><slot /></main>
    <footer class="c-footer">
      <div class="c-wrap c-footer-grid">
        <div>
          <p class="c-kicker">Amber &amp; Bean Coffee Roasters</p>
          <h2>Stay for one more cup.</h2>
        </div>
        <div class="c-footer-meta">
          <p>Tangerang Selatan, Banten</p>
          <p>Sen–Jum 08.00–22.00<br />Sab–Min 07.30–23.00</p>
        </div>
        <nav aria-label="Navigasi footer cafe">
          <a href={site.home}>Beranda</a>
          <a href={site.product}>Menu</a>
          <a href={site.contact}>Kontak</a>
          <a href={import.meta.env.BASE_URL}>Portal</a>
        </nav>
      <div class="c-wrap c-footer-bottom">
        <span>© 2026 Amber &amp; Bean · Slow roast · quiet room · warm pastry</span>
        <span>Pengembang Proyek Web Cafe: <strong>ANDIKA RAIHANSYAH (251010502968)</strong></span>
      </div>
    </footer>
  </body>
</html>
