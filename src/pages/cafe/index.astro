---
// Amber & Bean Coffee Roasters — Cafe Website Page
const menuCategories = [
  {
    category: "Signature Coffee & Espresso",
    items: [
      { name: "Amber Gold Cold Brew", desc: "Steeped 18 jam dengan roasted beans Aceh Gayo & notes citrus honey caramel.", price: "Rp 32.000", badge: "Best Seller" },
      { name: "Spanish Latte Cream", desc: "Double shot espresso blend, condensed milk, dan fresh oat milk velvety.", price: "Rp 28.000", badge: "Favorite" },
      { name: "Artisan Flat White", desc: "Ristretto shot seimbang dengan microfoam susu segar dan latte art swan.", price: "Rp 26.000", badge: "" },
      { name: "Single Origin V60 Pour Over", desc: "Pilihan beans beans: Ethiopia Yirgacheffe, Kerinci Kayu Aro, atau Bali Kintamani.", price: "Rp 35.000", badge: "Barista Choice" }
    ]
  },
  {
    category: "Artisan Pastry & Brunch",
    items: [
      { name: "Almond Butter Croissant", desc: "Flaky french pastry dengan frangipane paste panggang dan toasted sliced almond.", price: "Rp 27.000", badge: "Fresh Daily" },
      { name: "Sourdough Avocado Toast", desc: "Roti sourdough panggang, mashed avocado, poached egg, chili flakes, feta cheese.", price: "Rp 38.000", badge: "Healthy" },
      { name: "Smoked Beef & Melted Brioche", desc: "Brioche bun lembut, smoked beef brisket, cheddar meleleh, dan honey mustard.", price: "Rp 42.000", badge: "" }
    ]
  }
];

const facilities = [
  { icon: "⚡", title: "Colokan di Setiap Meja", desc: "Kapasitas colokan melimpah di setiap sudut, cocok buat nugas dan remote working seharian." },
  { icon: "📶", title: "Ultra High-Speed Wi-Fi", desc: "Koneksi internet dedicated 150 Mbps stabil tanpa putus untuk meeting daring." },
  { icon: "🌿", title: "Indoor & Outdoor Garden", desc: "Area indoor dingin bebas asap rokok dan outdoor breezy aesthetic yang nyaman." },
  { icon: "☕", title: "Beans Roasted In-House", desc: "Biji kopi dipanggang berkala untuk menjaga aroma bunga dan keasaman optimal." }
];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Amber & Bean — Artisan Coffee & Eatery</title>
  <link rel="icon" type="image/svg+xml" href="/logo-cafe.svg" />
  <style>
    :root {
      --primary: #B45309;
      --primary-dark: #78350F;
      --primary-light: #FDE68A;
      --bg: #FFFDF9;
      --surface: #FFFFFF;
      --text: #1C1917;
      --text-muted: #78716C;
      --border: #F5EBE1;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    body {
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    /* Top Portal Bar */
    .portal-nav {
      background: #1C1917;
      color: #D6D3D1;
      padding: 0.6rem 1.5rem;
      font-size: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .portal-nav a {
      color: #FDE68A;
      text-decoration: none;
      font-weight: 600;
    }
    .portal-nav a:hover {
      text-decoration: underline;
    }
    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 1140px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 1rem;
      text-decoration: none;
      color: var(--text);
    }
    .brand img {
      width: 48px;
      height: 48px;
    }
    .brand-title {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--primary-dark);
      display: block;
      line-height: 1.1;
    }
    .brand-subtitle {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--primary);
      text-transform: uppercase;
      font-weight: 600;
    }
    nav {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    nav a {
      text-decoration: none;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.2s;
    }
    nav a:hover {
      color: var(--primary);
    }
    .btn-header {
      background: var(--primary-dark);
      color: #FFFFFF !important;
      padding: 0.6rem 1.25rem;
      border-radius: 9999px;
      transition: all 0.2s;
    }
    .btn-header:hover {
      background: var(--primary);
    }
    /* Hero */
    .hero {
      padding: 5rem 1.5rem 4rem;
      background: linear-gradient(180deg, #FFFBEB 0%, var(--bg) 100%);
      text-align: center;
    }
    .hero-container {
      max-width: 820px;
      margin: 0 auto;
    }
    .badge-hero {
      display: inline-block;
      padding: 0.4rem 1.2rem;
      border-radius: 9999px;
      background: #FEF3C7;
      color: var(--primary-dark);
      border: 1px solid #FDE68A;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }
    .hero h1 {
      font-size: 3.25rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.03em;
      color: var(--primary-dark);
      margin-bottom: 1.25rem;
    }
    .hero p {
      font-size: 1.2rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
      line-height: 1.7;
    }
    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
      padding: 0.9rem 2rem;
      border-radius: 9999px;
      text-decoration: none;
      font-weight: 700;
      font-size: 1rem;
      transition: all 0.2s;
      box-shadow: 0 4px 14px rgba(180, 83, 9, 0.25);
    }
    .btn-primary:hover {
      background: var(--primary-dark);
    }
    .btn-secondary {
      background: var(--surface);
      color: var(--primary-dark);
      border: 1px solid var(--border);
      padding: 0.9rem 2rem;
      border-radius: 9999px;
      text-decoration: none;
      font-weight: 700;
      font-size: 1rem;
      transition: all 0.2s;
    }
    .btn-secondary:hover {
      background: #FEF3C7;
    }
    /* Section Shared */
    section {
      padding: 4.5rem 1.5rem;
    }
    .section-container {
      max-width: 1140px;
      margin: 0 auto;
    }
    .section-header {
      text-align: center;
      max-width: 650px;
      margin: 0 auto 3.5rem;
    }
    .section-header h2 {
      font-size: 2.25rem;
      font-weight: 800;
      color: var(--primary-dark);
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }
    .section-header p {
      color: var(--text-muted);
      font-size: 1.05rem;
    }
    /* Menu Grid */
    .menu-category {
      margin-bottom: 3rem;
    }
    .category-title {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--primary-dark);
      border-bottom: 2px solid var(--primary-light);
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
    }
    .menu-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s;
    }
    .menu-card:hover {
      border-color: #FCD34D;
      transform: translateY(-3px);
      box-shadow: 0 10px 25px -5px rgba(180, 83, 9, 0.08);
    }
    .menu-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
      gap: 1rem;
    }
    .menu-name {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--text);
    }
    .menu-price {
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--primary);
      white-space: nowrap;
    }
    .menu-desc {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 0.75rem;
    }
    .menu-badge {
      align-self: flex-start;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: #FEF3C7;
      color: var(--primary-dark);
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
    }
    /* Features */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.75rem;
    }
    .feature-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1.25rem;
      padding: 2rem 1.5rem;
      text-align: center;
    }
    .feature-icon {
      font-size: 2.25rem;
      margin-bottom: 1rem;
      display: inline-block;
    }
    .feature-card h3 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--primary-dark);
      margin-bottom: 0.5rem;
    }
    .feature-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
    }
    /* Footer */
    footer {
      background: #1C1917;
      color: #A8A29E;
      padding: 3.5rem 1.5rem 2rem;
    }
    .footer-inner {
      max-width: 1140px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      align-items: center;
      text-align: center;
    }
    .footer-logo {
      width: 60px;
      height: 60px;
    }
    .footer-nav {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-nav a {
      color: #E7E5E4;
      text-decoration: none;
      font-size: 0.95rem;
    }
    .footer-nav a:hover {
      color: #F59E0B;
    }
    .footer-copy {
      font-size: 0.85rem;
      color: #78716C;
      border-top: 1px solid #292524;
      padding-top: 2rem;
      width: 100%;
    }
  </style>
</head>
<body>
  <!-- Switcher Top Bar -->
  <div class="portal-nav">
    <span>🌐 Projek Tugas: Cafe & Dimsum</span>
    <div>
      <a href="/">← Kembali ke Portal</a> &nbsp;|&nbsp;
      <a href="/dimsum">Kunjungi Naga Steam Dimsum →</a>
    </div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-inner">
      <a href="/cafe" class="brand">
        <img src="/logo-cafe.svg" alt="Amber & Bean Logo" />
        <div>
          <span class="brand-title">AMBER &amp; BEAN</span>
          <span class="brand-subtitle">Specialty Coffee Roasters</span>
        </div>
      </a>
      <nav>
        <a href="#menu">Menu</a>
        <a href="#fasilitas">Fasilitas</a>
        <a href="#lokasi">Lokasi &amp; Jam Buka</a>
        <a href="https://wa.me/?text=Halo%20Amber%20Bean%2C%20mau%20reservasi" target="_blank" class="btn-header">Reservasi Meja</a>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-container">
      <span class="badge-hero">Artisan Coffee &amp; Quiet Working Space</span>
      <h1>Secangkir Ketenangan di Tengah Hiruk Pikuk Kota.</h1>
      <p>Biji kopi pilihan yang dipanggang sendiri, seduhan manual presisi, pastry hangat setiap pagi, dan suasana tenang yang dirancang khusus untuk inspirasi kerjamu.</p>
      <div class="hero-actions">
        <a href="#menu" class="btn-primary">Lihat Buku Menu</a>
        <a href="#lokasi" class="btn-secondary">Petunjuk Arah &amp; Jam Buka</a>
      </div>
    </div>
  </section>

  <!-- Menu Section -->
  <section id="menu">
    <div class="section-container">
      <div class="section-header">
        <h2>Pilihan Menu Favorit</h2>
        <p>Diramu dari bahan baku organik berkualitas tinggi untuk memanjakan lidah para pecinta cita rasa kopi sejati.</p>
      </div>

      {menuCategories.map((group) => (
        <div class="menu-category">
          <h3 class="category-title">{group.category}</h3>
          <div class="menu-grid">
            {group.items.map((item) => (
              <div class="menu-card">
                <div>
                  <div class="menu-top">
                    <span class="menu-name">{item.name}</span>
                    <span class="menu-price">{item.price}</span>
                  </div>
                  <p class="menu-desc">{item.desc}</p>
                </div>
                {item.badge && <span class="menu-badge">{item.badge}</span>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Facilities Section -->
  <section id="fasilitas" style="background: #FAF7F2;">
    <div class="section-container">
      <div class="section-header">
        <h2>Kenyamanan Tanpa Kompromi</h2>
        <p>Setiap meja dirancang untuk fokus kerja, berdiskusi santai, atau sekadar melepas lelah.</p>
      </div>
      <div class="features-grid">
        {facilities.map((fac) => (
          <div class="feature-card">
            <span class="feature-icon">{fac.icon}</span>
            <h3>{fac.title}</h3>
            <p>{fac.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Location & Hours Section -->
  <section id="lokasi">
    <div class="section-container">
      <div class="section-header">
        <h2>Kunjungi Kami</h2>
        <p>Buka setiap hari untuk menemani pagi cerahmu hingga malam santaimu.</p>
      </div>
      <div style="background: white; border: 1px solid var(--border); border-radius: 1.5rem; padding: 2.5rem; max-width: 720px; margin: 0 auto; text-align: center;">
        <h3 style="font-size: 1.5rem; color: var(--primary-dark); margin-bottom: 1rem;">Amber &amp; Bean Roastery Flagship</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Jl. Cemara Anggrek Raya No. 14, Senopati Selatan, Jakarta Selatan</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 1.25rem 0; margin-bottom: 1.75rem;">
          <div>
            <strong style="display: block; color: var(--text);">Senin — Jumat</strong>
            <span style="color: var(--text-muted); font-size: 0.95rem;">07.30 - 22.00 WIB</span>
          </div>
          <div>
            <strong style="display: block; color: var(--text);">Sabtu — Minggu</strong>
            <span style="color: var(--text-muted); font-size: 0.95rem;">07.00 - 23.00 WIB</span>
          </div>
        </div>
        <a href="https://maps.google.com" target="_blank" class="btn-primary" style="display: inline-block;">Buka di Google Maps</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-inner">
      <img src="/logo-cafe.svg" alt="Amber & Bean" class="footer-logo" />
      <div>
        <h4 style="color: white; font-size: 1.25rem; font-weight: 800; margin-bottom: 0.25rem;">AMBER &amp; BEAN</h4>
        <p style="font-size: 0.85rem; color: #78716C;">Specialty Coffee Roasters &amp; Eatery</p>
      </div>
      <div class="footer-nav">
        <a href="#menu">Menu</a>
        <a href="#fasilitas">Fasilitas</a>
        <a href="#lokasi">Lokasi</a>
        <a href="/dimsum">Kunjungi Naga Steam Dimsum</a>
        <a href="/">Kembali ke Portal Tugas</a>
      </div>
      <div class="footer-copy">
        &copy; {new Date().getFullYear()} Amber &amp; Bean Coffee Roasters. Bagian dari Tugas Web Projek Kuliah.
      </div>
    </div>
  </footer>
</body>
</html>
