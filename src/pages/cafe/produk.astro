---
import CafeLayout from '../../layouts/CafeLayout.astro';
import { cafeProducts } from '../../data/brands.js';
const categories = [...new Set(cafeProducts.map((item) => item.category))];
---
<CafeLayout active="product" title="Produk" description="Menu Amber & Bean Coffee Roasters: specialty coffee, pastry, brunch, dan non-coffee.">
  <section class="c-menu-hero">
    <div class="c-wrap c-menu-intro">
      <div><p class="c-kicker">Coffee · Pastry · Brunch</p><h1 class="c-display">Drink well.<br />Eat warm.</h1></div>
      <p class="c-lede">Menu dibuat ringkas supaya eksekusi tetap konsisten. Harga pada halaman ini adalah contoh untuk kebutuhan tugas kuliah dan dapat diganti langsung dari satu file data.</p>
    </div>
  </section>

  <section class="c-wrap c-menu-layout">
    <div class="c-menu-list">
      {categories.map((category) => (
        <section class="c-menu-category">
          <h2>{category}</h2>
          <div class="c-menu-items">
            {cafeProducts.filter((item) => item.category === category).map((item) => (
              <article class="c-menu-item">
                <div>
                  <h3>{item.name}</h3>
                  <p>{item.note}</p>
                  {item.badge && <span class="c-menu-badge">{item.badge}</span>}
                </div>
                <span class="c-menu-price">{item.price}</span>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
    <aside class="c-menu-aside">
      <img src="https://unsplash.com/photos/PaKa6QrFytA/download?force=true&w=900" alt="Kopi dan pastry Amber & Bean" />
      <h2>Pairing note.</h2>
      <p>Untuk rasa ringan pilih V60 atau Citrus Tonic. Kalau ingin creamy, Spanish Latte paling aman. Untuk brunch, Flat White + Smoked Beef Brioche adalah kombinasi paling seimbang.</p>
    </aside>
  </section>
</CafeLayout>
