---
// Naga Steam Dimsum House — Dimsum Restaurant Website Page
const dimsumCategories = [
  {
    category: "Dimsum Kukus Autentik (Steamed)",
    items: [
      { name: "Xiao Long Bao Kuah Jahe", desc: "Dumpling sup khas Shanghai berisi daging cincang juicy dengan kaldu gurih panas meleleh di mulut.", price: "Rp 32.000", badge: "Signature Chef" },
      { name: "Hakau Udang Kristal Emas", desc: "Kulit bening transparan kenyal berisi 2 ekor udang laut utuh segar yang manis dan garing.", price: "Rp 29.000", badge: "Best Seller" },
      { name: "Siomay Ayam Udang Jamur", desc: "Daging ayam cincang padat bertabur telur kepiting tobiko dan irisan jamur shiitake wangi.", price: "Rp 26.000", badge: "Favorite" },
      { name: "Bakpao Telur Asin Meleleh", desc: "Pao kukus super lembut dengan isian melted golden salted egg custard manis-gurih.", price: "Rp 24.000", badge: "Must Try" }
    ]
  },
  {
    category: "Dimsum Goreng Krispi (Fried & Crispy)",
    items: [
      { name: "Lumpia Kulit Tahu Udang", desc: "Kulit tahu renyah keemasan dibalut udang segar, disajikan dengan saus asam manis khas Kanton.", price: "Rp 28.000", badge: "Crispy" },
      { name: "Pangsit Udang Mayonnaise", desc: "Pangsit goreng mekar super renyah disajikan dengan dipping saus mayo creamy gurih.", price: "Rp 27.000", badge: "" },
      { name: "Wonton Ayam Chili Oil", desc: "Wonton rebus lembut dilumuri racikan Sichuan chili oil pedas aromatik dan daun ketumbar.", price: "Rp 30.000", badge: "Spicy" }
    ]
  }
];

const guarantees = [
  { icon: "🥟", title: "Freshly Steamed Setiap Pesanan", desc: "Dikukus langsung dari klakat bambu tradisional saat pesanan masuk, memastikan panas maksimal." },
  { icon: "🦐", title: "100% Udang & Daging Segar", desc: "Bebas bahan pengawet dan tanpa MSG berlebihan. Tekstur renyah alami dari bahan baku fresh harian." },
  { icon: "🌶️", title: "Chili Oil Racikan Spesial", desc: "Minyak cabai wangi rempah dengan bunga lawang, kapulaga, dan cabai kering pilihan." },
  { icon: "✨", title: "100% Halal & Higienis", desc: "Dipersiapkan dengan standar kebersihan restoran modern dan terverifikasi bahan halal." }
];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Naga Steam — Artisan Cantonese Dimsum House</title>
  <link rel="icon" type="image/svg+xml" href="/logo-dimsum.svg" />
  <style>
    :root {
      --primary: #E11D48;
      --primary-dark: #9F1239;
      --primary-light: #FFE4E6;
      --accent: #F59E0B;
      --bg: #FFF5F5;
      --surface: #FFFFFF;
      --text: #1C1917;
      --text-muted: #78716C;
      --border: #FEE2E2;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    body {
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    /* Top Portal Bar */
    .portal-nav {
      background: #881337;
      color: #FFE4E6;
      padding: 0.6rem 1.5rem;
      font-size: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .portal-nav a {
      color: #FDE68A;
      text-decoration: none;
      font-weight: 600;
    }
    .portal-nav a:hover {
      text-decoration: underline;
    }
    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 1140px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 1rem;
      text-decoration: none;
      color: var(--text);
    }
    .brand img {
      width: 48px;
      height: 48px;
    }
    .brand-title {
      font-size: 1.25rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: var(--primary-dark);
      display: block;
      line-height: 1.1;
    }
    .brand-subtitle {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--primary);
      text-transform: uppercase;
      font-weight: 700;
    }
    nav {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    nav a {
      text-decoration: none;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.2s;
    }
    nav a:hover {
      color: var(--primary);
    }
    .btn-header {
      background: var(--primary);
      color: #FFFFFF !important;
      padding: 0.6rem 1.25rem;
      border-radius: 9999px;
      transition: all 0.2s;
      font-weight: 700;
    }
    .btn-header:hover {
      background: var(--primary-dark);
    }
    /* Hero */
    .hero {
      padding: 5rem 1.5rem 4rem;
      background: linear-gradient(180deg, #FFE4E6 0%, var(--bg) 100%);
      text-align: center;
    }
    .hero-container {
      max-width: 820px;
      margin: 0 auto;
    }
    .badge-hero {
      display: inline-block;
      padding: 0.4rem 1.2rem;
      border-radius: 9999px;
      background: #FECDD3;
      color: var(--primary-dark);
      border: 1px solid #FDA4AF;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }
    .hero h1 {
      font-size: 3.25rem;
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -0.03em;
      color: var(--primary-dark);
      margin-bottom: 1.25rem;
    }
    .hero p {
      font-size: 1.2rem;
      color: #4C0519;
      margin-bottom: 2rem;
      line-height: 1.7;
      opacity: 0.85;
    }
    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
      padding: 0.9rem 2rem;
      border-radius: 9999px;
      text-decoration: none;
      font-weight: 800;
      font-size: 1rem;
      transition: all 0.2s;
      box-shadow: 0 4px 14px rgba(225, 29, 72, 0.3);
    }
    .btn-primary:hover {
      background: var(--primary-dark);
    }
    .btn-secondary {
      background: var(--surface);
      color: var(--primary-dark);
      border: 1px solid var(--border);
      padding: 0.9rem 2rem;
      border-radius: 9999px;
      text-decoration: none;
      font-weight: 700;
      font-size: 1rem;
      transition: all 0.2s;
    }
    .btn-secondary:hover {
      background: #FFE4E6;
    }
    /* Section Shared */
    section {
      padding: 4.5rem 1.5rem;
    }
    .section-container {
      max-width: 1140px;
      margin: 0 auto;
    }
    .section-header {
      text-align: center;
      max-width: 650px;
      margin: 0 auto 3.5rem;
    }
    .section-header h2 {
      font-size: 2.25rem;
      font-weight: 900;
      color: var(--primary-dark);
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }
    .section-header p {
      color: var(--text-muted);
      font-size: 1.05rem;
    }
    /* Menu Grid */
    .menu-category {
      margin-bottom: 3rem;
    }
    .category-title {
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--primary-dark);
      border-bottom: 2px solid #FECDD3;
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
    }
    .menu-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s;
    }
    .menu-card:hover {
      border-color: #FDA4AF;
      transform: translateY(-3px);
      box-shadow: 0 10px 25px -5px rgba(225, 29, 72, 0.1);
    }
    .menu-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
      gap: 1rem;
    }
    .menu-name {
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--text);
    }
    .menu-price {
      font-weight: 900;
      font-size: 1.1rem;
      color: var(--primary);
      white-space: nowrap;
    }
    .menu-desc {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 0.75rem;
    }
    .menu-badge {
      align-self: flex-start;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: #FFE4E6;
      color: var(--primary-dark);
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
    }
    /* Features */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.75rem;
    }
    .feature-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1.25rem;
      padding: 2rem 1.5rem;
      text-align: center;
    }
    .feature-icon {
      font-size: 2.25rem;
      margin-bottom: 1rem;
      display: inline-block;
    }
    .feature-card h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--primary-dark);
      margin-bottom: 0.5rem;
    }
    .feature-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
    }
    /* Footer */
    footer {
      background: #4C0519;
      color: #FECDD3;
      padding: 3.5rem 1.5rem 2rem;
    }
    .footer-inner {
      max-width: 1140px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      align-items: center;
      text-align: center;
    }
    .footer-logo {
      width: 60px;
      height: 60px;
    }
    .footer-nav {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-nav a {
      color: #FFE4E6;
      text-decoration: none;
      font-size: 0.95rem;
    }
    .footer-nav a:hover {
      color: #FDE68A;
    }
    .footer-copy {
      font-size: 0.85rem;
      color: #9F1239;
      border-top: 1px solid #881337;
      padding-top: 2rem;
      width: 100%;
    }
  </style>
</head>
<body>
  <!-- Switcher Top Bar -->
  <div class="portal-nav">
    <span>🥟 Projek Tugas: Cafe &amp; Dimsum</span>
    <div>
      <a href="/">← Kembali ke Portal</a> &nbsp;|&nbsp;
      <a href="/cafe">Kunjungi Amber &amp; Bean Cafe →</a>
    </div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-inner">
      <a href="/dimsum" class="brand">
        <img src="/logo-dimsum.svg" alt="Naga Steam Logo" />
        <div>
          <span class="brand-title">NAGA STEAM</span>
          <span class="brand-subtitle">Authentic Cantonese Dimsum</span>
        </div>
      </a>
      <nav>
        <a href="#menu">Menu Dimsum</a>
        <a href="#keunggulan">Kualitas Rasa</a>
        <a href="#lokasi">Outlet &amp; Jam Buka</a>
        <a href="https://wa.me/?text=Halo%20Naga%20Steam%2C%20mau%20pesan%20dimsum" target="_blank" class="btn-header">Pesan Online (WA)</a>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-container">
      <span class="badge-hero">Hangat dari Kukusan Bambu Tradisional</span>
      <h1>Kehangatan Dimsum Autentik di Setiap Gigitan.</h1>
      <p>Kelezatan resep turun-temurun Kanton dengan isian udang laut utuh, kuah xiao long bao yang meleleh di mulut, dan racikan chili oil pedas aromatik.</p>
      <div class="hero-actions">
        <a href="#menu" class="btn-primary">Pilih Menu Dimsum</a>
        <a href="#lokasi" class="btn-secondary">Lokasi Resto &amp; Jam Buka</a>
      </div>
    </div>
  </section>

  <!-- Menu Section -->
  <section id="menu">
    <div class="section-container">
      <div class="section-header">
        <h2>Menu Dimsum Favorit</h2>
        <p>100% Halal, dikukus dadakan saat dipesan agar kelezatan dan kelembutan adonan tetap terjaga sempurna.</p>
      </div>

      {dimsumCategories.map((group) => (
        <div class="menu-category">
          <h3 class="category-title">{group.category}</h3>
          <div class="menu-grid">
            {group.items.map((item) => (
              <div class="menu-card">
                <div>
                  <div class="menu-top">
                    <span class="menu-name">{item.name}</span>
                    <span class="menu-price">{item.price}</span>
                  </div>
                  <p class="menu-desc">{item.desc}</p>
                </div>
                {item.badge && <span class="menu-badge">{item.badge}</span>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Keunggulan Section -->
  <section id="keunggulan" style="background: #FFF1F2;">
    <div class="section-container">
      <div class="section-header">
        <h2>Standar Kualitas Naga Steam</h2>
        <p>Kami memegang teguh tradisi dapur Kanton tanpa kompromi pada kesegaran bahan.</p>
      </div>
      <div class="features-grid">
        {guarantees.map((g) => (
          <div class="feature-card">
            <span class="feature-icon">{g.icon}</span>
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Location & Hours Section -->
  <section id="lokasi">
    <div class="section-container">
      <div class="section-header">
        <h2>Kunjungi Resto Kami</h2>
        <p>Nikmati suasana makan bersama keluarga dan teman dalam klakat kukusan bambu hangat.</p>
      </div>
      <div style="background: white; border: 1px solid var(--border); border-radius: 1.5rem; padding: 2.5rem; max-width: 720px; margin: 0 auto; text-align: center;">
        <h3 style="font-size: 1.5rem; color: var(--primary-dark); margin-bottom: 1rem;">Naga Steam House — Flavor Hub</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Ruko Garden Boulevard Blok C No. 8, Bintaro Sektor 7, Tangerang Selatan</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 1.25rem 0; margin-bottom: 1.75rem;">
          <div>
            <strong style="display: block; color: var(--text);">Setiap Hari (Sesi Pagi-Sore)</strong>
            <span style="color: var(--text-muted); font-size: 0.95rem;">08.00 - 15.00 WIB</span>
          </div>
          <div>
            <strong style="display: block; color: var(--text);">Setiap Hari (Sesi Malam)</strong>
            <span style="color: var(--text-muted); font-size: 0.95rem;">17.00 - 23.00 WIB</span>
          </div>
        </div>
        <a href="https://maps.google.com" target="_blank" class="btn-primary" style="display: inline-block;">Petunjuk Arah Google Maps</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-inner">
      <img src="/logo-dimsum.svg" alt="Naga Steam" class="footer-logo" />
      <div>
        <h4 style="color: white; font-size: 1.25rem; font-weight: 900; margin-bottom: 0.25rem;">NAGA STEAM</h4>
        <p style="font-size: 0.85rem; color: #FECDD3;">Authentic Cantonese Dimsum House &bull; 100% Halal</p>
      </div>
      <div class="footer-nav">
        <a href="#menu">Menu</a>
        <a href="#keunggulan">Kualitas</a>
        <a href="#lokasi">Lokasi</a>
        <a href="/cafe">Kunjungi Amber &amp; Bean Cafe</a>
        <a href="/">Kembali ke Portal Tugas</a>
      </div>
      <div class="footer-copy">
        &copy; {new Date().getFullYear()} Naga Steam Dimsum House. Bagian dari Tugas Web Projek Kuliah.
      </div>
    </div>
  </footer>
</body>
</html>
