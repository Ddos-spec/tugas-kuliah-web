---
import DimsumLayout from '../../layouts/DimsumLayout.astro';
import { dimsumProducts } from '../../data/brands.js';
const featured = dimsumProducts.slice(0, 3);
---
<DimsumLayout active="home" title="Beranda" description="Naga Steam Dimsum House — Restoran dimsum kukus autentik hangat dan lezat di Tangerang Selatan.">
  <!-- Hero Section -->
  <section class="d-hero">
    <div class="d-wrap d-hero-grid">
      <div class="d-hero-copy">
        <span class="d-label">100% Halal &amp; Fresh Steamed</span>
        <h1 class="d-display">Kelezatan Dimsum Autentik Hangat dari Kukusan.</h1>
        <p class="d-copy">Naga Steam menyajikan aneka pilihan dimsum kukus dan goreng bergaya Kanton. Dibuat dari bahan udang dan ayam pilihan, dengan kuah sup xiao long bao yang meleleh lezat di mulut.</p>
        <div class="d-hero-actions">
          <a class="d-button d-button--dark" href="/dimsum/produk/">Lihat Daftar Menu</a>
          <a class="d-button d-button--ghost" href="/dimsum/kontak/">Reservasi Tempat</a>
        </div>
      </div>
      <div class="d-hero-media">
        <img src="https://unsplash.com/photos/j9fy7p_hcpM/download?force=true&w=1600" alt="Xiao long bao hangat di dalam kukusan bambu" />
      </div>
    </div>
  </section>

  <!-- 4 Keunggulan Strip -->
  <div class="d-wrap">
    <section class="d-strip" aria-label="Keunggulan Naga Steam">
      <div class="d-strip-item">
        <strong>🥟 Dibuat Segar</strong>
        <span>Kualitas terjaga setiap hari</span>
      </div>
      <div class="d-strip-item">
        <strong>🔥 Kukus Dadakan</strong>
        <span>Disajikan panas saat dipesan</span>
      </div>
      <div class="d-strip-item">
        <strong>🦐 Udang Pilihan</strong>
        <span>Isian juicy tanpa pengawet</span>
      </div>
      <div class="d-strip-item">
        <strong>🍵 Teh Melati Wangi</strong>
        <span>Pilihan Jasmine &amp; HK Milk Tea</span>
      </div>
    </section>
  </div>

  <!-- Tentang Restoran -->
  <section class="d-section">
    <div class="d-wrap">
      <div class="d-section-head">
        <h2 class="d-title">Cita Rasa Kanton Tradisional</h2>
        <p class="d-copy">Kami menjaga standar kebersihan dan teknik pengukusan bambu tradisional agar kelembutan kulit dan kesegaran daging tetap optimal saat dinikmati bersama keluarga.</p>
      </div>
      <div class="d-photo-wall">
        <figure><img src="https://unsplash.com/photos/idUSfFfqLmw/download?force=true&w=1600" alt="Steamed dumplings di dalam bamboo steamer" /></figure>
        <figure><img src="https://unsplash.com/photos/IhR3WOLuM7M/download?force=true&w=1200" alt="Beragam dimsum dan side dish" /></figure>
      </div>
    </div>
  </section>

  <!-- Mengapa Memilih Kami -->
  <section class="d-section d-section--light-red">
    <div class="d-wrap">
      <div class="d-section-head">
        <h2 class="d-title">Standar Dapur Naga Steam</h2>
        <p class="d-copy">Tiga komitmen utama kami untuk menyajikan makanan terbaik kepada setiap pelanggan.</p>
      </div>
      <div class="d-system">
        <article>
          <span>1</span>
          <h3>Bahan Segar</h3>
          <p>Adonan kulit dan isian daging udang disiapkan berkala sehingga tidak kering.</p>
        </article>
        <article>
          <span>2</span>
          <h3>Waktu Kukus Pas</h3>
          <p>Kukusan bambu diatur suhunya secara teliti agar tidak lembek dan tetap juicy.</p>
        </article>
        <article>
          <span>3</span>
          <h3>Langsung Disajikan</h3>
          <p>Tutup kukusan baru dibuka di meja Anda agar aroma dan kehangatannya maksimal.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Menu Favorit -->
  <section class="d-section">
    <div class="d-wrap">
      <div class="d-section-head">
        <h2 class="d-title">Menu Favorit Pilihan</h2>
        <p class="d-copy">Rekomendasi hidangan paling laris yang wajib dicoba saat pertama kali mampir ke outlet kami.</p>
      </div>
      <div class="d-favourites">
        {featured.map((item) => (
          <article class="d-favourite">
            <div>
              <div class="d-card-top">
                <span class="d-badge">{item.category}</span>
                <span class="d-price">{item.price}</span>
              </div>
              <h3>{item.name}</h3>
              <p>{item.note}</p>
            </div>
            <div style="margin-top: 1rem; text-align: right;">
              <a href="/dimsum/produk/" style="color: #C53030; font-weight: 700; font-size: 0.88rem;">Detail Menu →</a>
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 2.5rem;">
        <a class="d-button d-button--dark" href="/dimsum/produk/">Lihat Semua Menu Makanan →</a>
      </div>
    </div>
  </section>
</DimsumLayout>
