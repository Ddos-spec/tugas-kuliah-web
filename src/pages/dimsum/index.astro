---
import BrandLayout from '../../layouts/BrandLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { dimsumProducts } from '../../data/brands.js';
---
<BrandLayout brand="dimsum" active="home" title="Beranda" description="Naga Steam Dimsum House — Cantonese-inspired dimsum, bamboo steamers, dan sajian panas yang dibuat fresh.">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Folded by hand · Steamed to order</p>
        <h1 class="display">Hot steam.<br />Soft folds.</h1>
        <p class="lede">Naga Steam menyajikan dimsum bergaya Kanton dengan fokus pada tekstur: kulit tipis, filling juicy, broth panas, dan kukusan bambu yang baru dibuka saat sampai ke meja.</p>
        <div class="hero-actions">
          <a class="button button--solid" href="/dimsum/produk/">Lihat menu</a>
          <a class="button button--ghost" href="/dimsum/kontak/">Reservasi meja</a>
        </div>
      </div>
      <div class="hero-media">
        <img src="https://unsplash.com/photos/j9fy7p_hcpM/download?force=true&w=1600" alt="Xiao long bao hangat di dalam kukusan bambu" />
        <span class="hero-stamp">Steam to order · Bamboo basket · Served hot</span>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__row">
      <span>Xiao Long Bao</span><span>Har Gow</span><span>Siu Mai</span><span>Jasmine Tea</span><span>Xiao Long Bao</span><span>Har Gow</span><span>Siu Mai</span><span>Jasmine Tea</span>
    </div>
  </div>

  <section class="section section--paper">
    <div class="shell section-head">
      <div><p class="eyebrow">Straight from the steamer</p><h2 class="section-title">Fresh folds,<br />not display food.</h2></div>
      <p class="lede">Kualitas dimsum turun cepat setelah keluar dari kukusan. Karena itu alurnya sederhana: batch kecil, steam to order, lalu langsung ke meja.</p>
    </div>
    <div class="shell image-pair">
      <figure><img src="https://unsplash.com/photos/idUSfFfqLmw/download?force=true&w=1600" alt="Steamed dumplings di dalam bamboo steamer" /></figure>
      <figure><img src="https://unsplash.com/photos/IhR3WOLuM7M/download?force=true&w=1200" alt="Beragam dimsum dan side dish" /></figure>
    </div>
  </section>

  <section class="section">
    <div class="shell story-grid">
      <div>
        <p class="eyebrow">The Naga standard</p>
        <h2 class="section-title">Texture first.<br />Then flavour.</h2>
        <p class="lede" style="margin-top:1.5rem">Dimsum yang bagus bukan cuma soal isian. Kulit, kelembapan, suhu, dan timing steam harus bertemu di satu titik.</p>
      </div>
      <ol class="story-list">
        <li><strong>01</strong><span><b>Folded in small batches.</b> Wrapper tidak dibiarkan mengering sebelum masuk steamer.</span></li>
        <li><strong>02</strong><span><b>Steam to order.</b> Setiap basket punya timing sendiri supaya kulit tidak overcooked.</span></li>
        <li><strong>03</strong><span><b>Serve immediately.</b> Basket dibuka di meja agar aroma dan teksturnya masih tepat.</span></li>
      </ol>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell section-head">
      <div><p class="eyebrow">House favourites</p><h2 class="section-title">Order these first.</h2></div>
      <p class="lede">Kalau baru pertama datang, mulai dari tiga item ini untuk dapat gambaran karakter Naga Steam: broth, prawn texture, dan umami.</p>
    </div>
    <div class="shell"><ProductGrid products={dimsumProducts} limit={3} /></div>
    <div class="shell" style="margin-top:1.5rem"><a class="button button--ghost" href="/dimsum/produk/">Buka seluruh menu →</a></div>
  </section>
</BrandLayout>
