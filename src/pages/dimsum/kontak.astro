---
import DimsumLayout from '../../layouts/DimsumLayout.astro';
---
<DimsumLayout active="contact" title="Kontak" description="Kontak, jam buka, dan reservasi Naga Steam Dimsum House.">
  <section class="d-contact">
    <div class="d-contact-panel">
      <p class="d-label">Book / Ask / Gather</p>
      <h1 class="d-display">BRING<br />THE<br />WHOLE<br />TABLE.</h1>
      <p class="d-copy">Reservasi disarankan untuk grup supaya basket bisa masuk meja bertahap dan tetap panas. Kontak di bawah adalah data demo untuk kebutuhan tugas.</p>
      <dl class="d-contact-data">
        <div class="d-contact-row"><dt>Area</dt><dd>Tangerang Selatan, Banten</dd></div>
        <div class="d-contact-row"><dt>Hours</dt><dd>Sen–Jum 10.00–22.00<br />Sab–Min 09.00–23.00</dd></div>
        <div class="d-contact-row"><dt>Email</dt><dd>hello@nagasteam.example</dd></div>
        <div class="d-contact-row"><dt>Phone</dt><dd>+62 812 0000 0002</dd></div>
      </dl>
    </div>
    <div class="d-booking">
      <div class="d-booking-head"><h1>Reserve<br />a basket.</h1><span>FORM / 03</span></div>
      <form action="mailto:hello@nagasteam.example" method="post" enctype="text/plain">
        <div class="d-form">
          <div class="d-field"><label for="name">Nama</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="d-field"><label for="phone">Nomor HP</label><input id="phone" name="phone" autocomplete="tel" required /></div>
          <div class="d-field"><label for="date">Tanggal</label><input id="date" name="date" type="date" /></div>
          <div class="d-field"><label for="people">Jumlah orang</label><input id="people" name="people" type="number" min="1" max="30" /></div>
          <div class="d-field d-field--full"><label for="message">Catatan</label><textarea id="message" name="message" placeholder="High chair, alergi, kebutuhan meja, dll."></textarea></div>
        </div>
        <button class="d-button d-button--red" type="submit">SEND RESERVATION →</button>
        <p class="d-form-note">Demo statis memakai <code>mailto:</code>; tidak perlu backend dan tetap aman untuk dipresentasikan.</p>
      </form>
    </div>
  </section>
</DimsumLayout>
