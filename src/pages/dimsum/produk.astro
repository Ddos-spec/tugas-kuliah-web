---
import DimsumLayout from '../../layouts/DimsumLayout.astro';
import { dimsumProducts } from '../../data/brands.js';
const categories = ['Semua', ...new Set(dimsumProducts.map((item) => item.category))];
---
<DimsumLayout active="product" title="Produk" description="Menu Naga Steam Dimsum House: xiao long bao, har gow, siu mai, fried dimsum, dessert, dan tea.">
  <section class="d-menu-hero">
    <div class="d-wrap d-menu-top">
      <div><p class="d-label">Menu / Steam / Tea</p><h1 class="d-display">FOLDED<br />FRESH.</h1></div>
      <p class="d-copy">Menu dibuat cukup luas untuk terlihat lengkap, tetapi tetap realistis untuk operasi satu dimsum house. Harga adalah data demo tugas dan bisa diubah dari satu file data.</p>
    </div>
    <div class="d-wrap d-category-row" aria-label="Kategori menu">{categories.map((category) => <span>{category}</span>)}</div>
  </section>

  <section class="d-menu-zone">
    <div class="d-wrap d-menu-grid">
      {dimsumProducts.map((item, index) => (
        <article class="d-menu-card">
          <div class="d-menu-num"><span>{String(index + 1).padStart(2, '0')} / {item.category}</span><span>{item.price}</span></div>
          <h2>{item.name}</h2>
          <p>{item.note}</p>
          {item.badge && <em>{item.badge}</em>}
        </article>
      ))}
    </div>
    <div class="d-wrap d-order-note"><h2>Build one good basket.</h2><p>Untuk dua orang: Xiao Long Bao + Har Gow + Siu Mai, lalu satu fried item dan Jasmine Cold Brew Tea. Cukup beragam tanpa bikin meja penuh basket yang cepat dingin.</p></div>
  </section>
</DimsumLayout>
