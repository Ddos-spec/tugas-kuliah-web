---
import DimsumLayout from '../../layouts/DimsumLayout.astro';
import { brands, dimsumProducts } from '../../data/brands.js';
const categories = ['Semua Kategori', ...new Set(dimsumProducts.map((item) => item.category))];
---
<DimsumLayout active="product" title="Daftar Menu" description="Daftar lengkap menu hidangan Naga Steam Dimsum: Dimsum Kukus, Goreng, Hidangan Penutup, dan Minuman Teh.">
  <!-- Menu Header -->
  <section class="d-menu-hero">
    <div class="d-wrap">
      <h1>Daftar Menu Dimsum</h1>
      <p>Pilihan hidangan dimsum halal, renyah, dan lezat dengan harga terjangkau. Disajikan segar setiap hari.</p>
      <div class="d-category-row" aria-label="Kategori menu">
        {categories.map((category) => (
          <span class="d-category-badge">{category}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Grid Menu Makanan -->
  <section class="d-section">
    <div class="d-wrap">
      <div class="d-menu-grid">
        {dimsumProducts.map((item) => (
          <article class="d-menu-card">
            <div>
              <div class="d-card-top">
                <span class="d-badge">{item.category}</span>
                <span class="d-price">{item.price}</span>
              </div>
              <h2>{item.name}</h2>
              <p>{item.note}</p>
            </div>
            {item.badge && (
              <div style="margin-top: 1rem;">
                <span style="display: inline-block; font-size: 0.75rem; font-weight: 700; background: #FED7D7; color: #9B2C2C; padding: 0.2rem 0.6rem; border-radius: 4px;">
                  ★ {item.badge}
                </span>
              </div>
            )}
          </article>
        ))}
      </div>

      <!-- Info Pemesanan -->
      <div style="margin-top: 3rem; background: #FFF5F5; border: 2px dashed #FEB2B2; border-radius: 12px; padding: 2rem; text-align: center;">
        <h3 style="font-size: 1.35rem; color: #9B2C2C; margin-bottom: 0.5rem;">Tips Rekomendasi Porsi</h3>
        <p style="color: #4A5568; max-width: 650px; margin: 0 auto 1.5rem;">
          Untuk 2 orang, kami sarankan memesan 3 basket kukus (Xiao Long Bao + Hakau + Siomay), 1 porsi goreng, dan 2 cangkir teh melati hangat agar porsi pas dan tetap hangat saat disantap.
        </p>
        <a class="d-button d-button--dark" href={brands.dimsum.contact}>Pesan Tempat Sekarang</a>
      </div>
    </div>
  </section>
</DimsumLayout>
