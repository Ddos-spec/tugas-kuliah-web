---
import '../styles/global.css';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portal dua website tugas kuliah: Amber & Bean Coffee Roasters dan Naga Steam Dimsum House." />
    <link rel="icon" type="image/svg+xml" href="/logo-cafe.svg" />
    <title>Amber & Bean × Naga Steam — Web Project</title>
  </head>
  <body class="portal">
    <header class="portal__top">
      <strong>Two Houses. One Web Project.</strong>
      <span>Astro 5 · Responsive · Multi-page</span>
    </header>
    <main class="portal-grid">
      <a class="portal-card" href="/cafe/" aria-label="Masuk ke Amber & Bean Coffee Roasters">
        <img src="https://unsplash.com/photos/PaKa6QrFytA/download?force=true&w=1600" alt="Interior coffee bar dengan pastry dan perlengkapan kopi" />
        <div class="portal-card__copy">
          <small>01 · Coffee House</small>
          <h1>Amber<br />&amp; Bean</h1>
          <p>Warm roast, quiet tables, and a slow-morning attitude. Specialty coffee presented with restrained editorial styling.</p>
          <span class="portal-card__arrow">Enter coffee house →</span>
        </div>
      </a>
      <a class="portal-card" href="/dimsum/" aria-label="Masuk ke Naga Steam Dimsum House">
        <img src="https://unsplash.com/photos/idUSfFfqLmw/download?force=true&w=1600" alt="Xiao long bao di dalam kukusan bambu" />
        <div class="portal-card__copy">
          <small>02 · Dimsum House</small>
          <h1>Naga<br />Steam</h1>
          <p>Fresh folds, hot steam, bamboo baskets, and a Cantonese-inspired dining rhythm with crisp modern typography.</p>
          <span class="portal-card__arrow">Enter dimsum house →</span>
        </div>
      </a>
    </main>
    <footer class="portal__foot">Academic project · all food imagery sourced from Unsplash pages referenced in the project notes.</footer>
  </body>
</html>
